{
  "name": "rovqix",
  "private": true,
  "packageManager": "npm@11.13.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=@rovqix/web",
    "build": "turbo run build --filter=@rovqix/web",
    "build:web": "turbo run build --filter=@rovqix/web",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "cf:projects": "node scripts/cloudflare-projects.mjs",
    "cf:setup": "node scripts/cloudflare-setup.mjs",
    "dev:area": "turbo run dev --filter=@rovqix/plumber-websites",
    "build:areas": "turbo run build --filter=./apps/*-websites --concurrency=1",
    "create:area-apps": "node scripts/create-area-apps.mjs"
  },
  "devDependencies": {
    "turbo": "2.11.4"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
